#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&soft_off {
    hold-time-ms = <2000>;
};

/ {
    behaviors {
        ltc: layer_tap_custom {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;  // layer activation
            quick-tap-ms = <200>;     // multi-tap
            bindings = <&mo>, <&kp>;
        };
        mtc: mod_tap_custom {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        combo_ble_clear {
            timeout-ms = <50>;
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 18>;            
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            //quick-tap-ms = <200>;
            bindings = <
                &kp GRAVE         &kp F1         &kp F2            &kp F3            &kp F4             &kp F5
                &kp EQUAL         &kp Q          &kp W             &kp E             &kp R              &kp T
                &kp MINUS         &kp A          &kp S             &kp D             &kp F              &kp G
                &kp BACKSLASH     &kp Z          &kp X             &kp C             &kp V              &kp B
                &mtc LCTRL TAB    &ltc 1 BSPC    &mtc LSHFT SPACE  &mtc LGUI ENTER   &mtc LALT DEL       
                    
                &kp F6            &kp F7         &kp F8            &kp F9            &kp F10            &kp F11
                &kp Y             &kp U          &kp I             &kp O             &kp P              &kp LEFT_BRACKET
                &kp H             &kp J          &kp K             &kp L             &kp SEMI           &kp APOS
                &kp N             &kp M          &kp COMMA         &kp DOT           &kp FSLH           &kp RIGHT_BRACKET
                                  &mtc RALT INS  &mtc RGUI ENTER   &mtc RSHFT SPACE  &ltc 1 ESC         &mtc RCTRL TAB
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp PSCRN       &trans          &trans          &trans             &trans            &trans
                &kp KP_PLUS     &none           &kp N7          &kp N8             &kp N9            &none
                &kp KP_MINUS    &none           &kp N4          &kp N5             &kp N6            &none
                &none           &none           &kp N1          &kp N2             &kp N3            &kp N0
                                &trans          &trans          &trans             &trans            &trans
            
                &trans          &trans          &trans          &trans             &trans            &kp F12
                &none           &kp PG_UP       &kp UP          &none              &none             &kp KP_MULTIPLY
                &kp HOME        &kp LEFT        &kp DOWN        &kp RIGHT          &kp END           &kp KP_DIVIDE
                &none           &kp PG_DN       &trans          &trans             &trans            &kp PAUSE_BREAK 
                                &trans          &trans          &trans             &trans            &trans
            >;
        };
    };
};
